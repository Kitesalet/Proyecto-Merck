@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model ProyectoMerck.Models.ViewModels.HomeVM

@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


</head>
<body class="d-flex align-items-center justify-content-center body">
    <header class="header-bg-color">
        <nav class="navbar navbar-expand-sm navbar-light">
            <div class="container-fluid">
                <form action="@Url.Action("ChangeCulture","Language")" method="get" id="languageForm" class="m-2">
                    <input type="hidden" id="cultureInput" name="culture" />
                    <span value="en"  class="btn"><img src="~/Imagenes/Flag_of_the_United_Kingdom.png" class="flag-small @(Model.CurrentCulture == "en" ? "flag-selected" : "")" /></span>
                    <span value="pt"  class="btn"><img src="~/Imagenes/Flag_of_Portugal.svg" class="flag-small @(Model.CurrentCulture == "pt" ? "flag-selected" : "")" /></span>
                    <span value="es"  class="btn"><img src="~/Imagenes/Spain_flag_300.png" class="flag-small @(Model.CurrentCulture == "es" ? "flag-selected" : "")" /></span>
                </form>
            </div>
        </nav>
    </header>
@*     <h1 class="text-center text-light">@Localizer["ScreenLanguage"]: @Localizer["Language"]</h1>
 *@    <div class="container text-center">
        <div class="row">
            <div class="col-12">
                <img src="~/Imagenes/LogoInicioMerck.png" />
            </div>
        </div>
    </div>
    <div class="container text-center">
        <div class="row">
            <div class="col-12">
                <a id="m-button" class="btn py-4 my-5 border-light merck-button" style="" href="@Url.Action("Index", "Fertform")">
                    <span class="spinner-container"></span>
                    <span class="m-button-span">@* @(Localizer["Start"]) *@Comenzar</span>
                </a>
            </div>
        </div>
    </div>



    <script src="/js/site.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>
<footer>

    <div class="footer-detail" bis_skin_checked="1">
        <div class="row" bis_skin_checked="1">
            <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                <div class="footer-copyright" bis_skin_checked="1">
                    <p class="small">© 2024 Merck KGaA, Darmstadt, Alemania y/o sus filiales. Todos los derechos reservados.</p>
                </div>
            </div>
            <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                <div class="footer-legal" bis_skin_checked="1">
                    <ul class="unstyled small flush-bottom">
                        <li class="footer-legal-item">
                            <a asp-action="Privacy" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Declaración de Privacidad</strong></a>
                        </li>
                        <li class="footer-legal-item">
                            <a asp-action="TyC" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Términos y Condiciones</strong></a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>

<script>

    var flags = document.querySelectorAll('.flag-small');

    flags.forEach(function (flag) {

        flag.addEventListener('click', function(){
            
            flags.forEach(function(flag){
                flag.classList.remove('flag-selected');
            })

            console.log(flag);

            flag.classList.add('flag-selected');

            var cultureValue = flag.parentElement.getAttribute('value');

            var elemento = document.getElementById('cultureInput').value = cultureValue;

            document.getElementById('languageForm').submit();

        })
    })

</script>