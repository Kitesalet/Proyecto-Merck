<script src="~/js/clinics.js"></script>

<script>

    var provinceList = @Html.Raw(Json.Serialize(Model.ProvincList));
    var locationList = @Html.Raw(Json.Serialize(Model.ProvinceLocationList));
    var clinicLocationList = @Html.Raw(Json.Serialize(Model.LocationsList));
    var errorHappened = '@Model.SubmitError'.toLowerCase() === 'true';

    var button = document.getElementById('clinicButton');

    provinceHandler(locationList, 1);

    document.getElementById('fertFormulary').addEventListener('submit', function (e) {
        e.preventDefault();


        let formData = new FormData(this);


      
        var selectedClinicId = parseInt(formData.get("SelectedLocationIndex"));
        var selectedConsult = formData.get("ReasonConsultation");
        var selectedName = formData.get("FullName");
        var selectedMail = formData.get("Email");
        var selectedPhone = formData.get("TelephoneNumber");

        var gtagFlag = true;

        function isNullOrEmpty(value) {
            return value === null || value === undefined || (typeof value === 'string' && value.trim() === '') || (typeof value === 'number' && isNaN(value));
        }

        if (isNullOrEmpty(selectedConsult) || isNullOrEmpty(selectedName) || isNullOrEmpty(selectedMail) || isNullOrEmpty(selectedPhone)) {
            gtagFlag = false // At least one field is null, undefined, or empty
        }

        // Check if phone number has at least 5 digits and less than 14 digits
        if (isNaN(selectedPhone) || selectedPhone.length < 5 || selectedPhone.length >= 14) {
            gtagFlag = false; // Phone number is not valid
        }


        var selectedClinic = clinicLocationList.find(function(e){
           return e.id === selectedClinicId;
        })

        if(gtagFlag === true){
             gtag('event', 'consultation_form_submitted', {
                        'event_category': 'Form Submission',
                        'event_label': 'Fertility Formulary Submitted',
                        'clinica_seleccionada': selectedClinic.title,
                        'opcion_consulta': selectedConsult
             });
        
            console.log('gtag sent');
        }


            let spinnerContainer = document.getElementById('spinner-container');
            let buttonSpan = document.querySelector('.m-button-span');

            

            buttonSpan.classList.add('d-none');
            spinnerContainer.classList.add('spinner-grow', 'text-light');

            console.log(spinnerContainer);



        this.submit();



    })
</script>



