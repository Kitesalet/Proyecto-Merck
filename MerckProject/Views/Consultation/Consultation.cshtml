@model ConsultationViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using ProyectoMerck.Models.ViewModels
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Consultation";
}

<header class="rich-purple-bg">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
        <div class="container-fluid">
            <a href="@Url.Action("Index", "Home")" class="btn"><i class="bi bi-chevron-left header-icon-left"></i></a>
            <button class="navbar-toggler header-burger" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-light"></i>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="row subheader-body rich-purple-bg">
    <div class="col-md-12">
        <div class="col-12 text-center vh-50 mt-35">
            <div class="text-center subheader-div">
                <div class="row align-items-center">
                    <div class="col-12">
                        <p class="h2 mb-0 text-white opacity-75"><strong class="vibrant-pink">CONSULTA</strong></p>
                    </div>
                    <div class="col"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row rounded-header">
    </div>
</div>

<div class="container">

@using (Html.BeginForm("AddConsultation", "Consultation", FormMethod.Post))
{       
        <input type="hidden" name="SelectedCountry" id="SelectedCountry" value="2"/>
        <input type="hidden" name="SelectedProvince" id="SelectedProvince" value="1"/>
        @Html.HiddenFor(c => c.Locations)
        @Html.HiddenFor(c => c.SelectedLocationIndex, new { id = "SelectedLocationIndex" })
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
@*         <div class="row" >
            <div class="col text-center">
                <img src="~/imagenes/FotoUbicacion.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="Country" class="form-label consultation-label">Pais</label>
                @Html.DropDownListFor(p => p.SelectedCountry, Model.CountryList.Select(c =>
                         new SelectListItem()
            {
                Value = c.Id.ToString(),
                Text = c.Name
            }), "--- Seleccione una opción ---",
                         new { @class = "form-select form-select-lg mb-3", aria_label = ".form-select-lg example", id = "countryDropdown" })
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>
        </div> *@

        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoUbicacion.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="Province" class="form-label consultation-label">Provincia</label>

                    @Html.DropDownListFor(p => p.SelectedProvince, Model.ProvincList.Select(c =>
                             new SelectListItem()
                    {
                        Value = c.Id.ToString(),
                        Text = c.Name
                    }), "Seleccionar",
                     new { @class = "form-select form-select-lg mb-3", aria_label = ".form-select-lg example", id = "provinceDropdown", disabled = true})
                
                @*else
                {
                    @Html.DropDownListFor(p => p.SelectedProvince, Enumerable.Empty<SelectListItem>(), "Seleccionar", new { @class = "form-select form-select-lg mb-3", aria_label = ".form-select-lg example", id = "provinceDropdown" })
                } *@
                <span asp-validation-for="Province" class="text-danger"></span>
            </div>
        </div>

        <div id="endContainer"></div>



        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoUbicacion.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="Location" class="form-label consultation-label">Barrio</label>
                @if (Model.SubmitError == true)
                {
                    @Html.DropDownListFor(p => p.SelectedProvinceLocation, Model.ProvinceLocationList.Select(c =>
                             new SelectListItem()
                    {
                        Text = c.Name.ToString(),
                        Value = c.Id.ToString()
                    }
                             )
                             , "Seleccionar",
                             new { @class = "form-select form-select-lg mb-3", aria_label = ".form-select-lg example", id = "provinceLocationDropdown" })

                }
                else
                {
                    @Html.DropDownListFor(p => p.SelectedProvinceLocation, Enumerable.Empty<SelectListItem>(), new { @class = "form-select form-select-lg mb-3", aria_label = ".form-select-lg example", id = "provinceLocationDropdown" })
                }
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoEmail.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="FullName" class="form-label consultation-label-2">Nombre Completo</label>
                <div class="d-flex align-self-end">
                    @Html.TextBoxFor(p => p.FullName,
                             new { @class = "form-control" })
                </div>
                <div class="row">
                    <span asp-validation-for="FullName" class="text-danger"></span>

                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoEmail.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="Email" class="form-label consultation-label-2">Mail contacto</label>
                <div class="d-flex align-self-end">
                    @Html.TextBoxFor(p => p.Email,
                             new { @class = "form-control" })    
                </div>
                <div class="row">
                        <span asp-validation-for="Email" class="text-danger"></span>

                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoEmail.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="TelephoneNumber" class="form-label consultation-label-2">Teléfono</label>
                <div class="d-flex align-self-end">
                    @Html.TextBoxFor(p => p.TelephoneNumber,
                             new { @class = "form-control", type = "number" })
                </div>
                <div class="row">
                    <span asp-validation-for="TelephoneNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col text-center">
                <img src="~/imagenes/FotoConsulta.png" class="img-fluid" />
            </div>
            <div class="col-8 pe-3">
                <label asp-for="ReasonConsultation" class="form-label consultation-label-2">Motivo consulta</label>
                <div class="d-flex align-self-end">
                    @{
                        var consultMotives = new List<SelectListItem>
                {
                new SelectListItem {Text = "Seleccionar", Value = "Seleccionar", Disabled = true, Selected = true },
                new SelectListItem { Text = "Quiero criopreservar ovocitos", Value = "Quiero criopreservar ovocitos" },
                new SelectListItem { Text = "Quiero conocer más sobre el estado de mi fertilidad", Value = "Quiero conocer más sobre el estado de mi fertilidad" },
                new SelectListItem { Text = "Otras razones", Value = "Otras razones" },
                };

                                @Html.DropDownListFor(model => model.ReasonConsultation,consultMotives, new { @class = "form-control" })
                    }

                </div>
                    <div class="row">
                    <span asp-validation-for="ReasonConsultation" class="text-danger"></span>
                    </div>
         </div>
        </div>

        <div class="container mt-4">

            <div  id="clinicContainer" class="@* row mx-5 d-flex *@ @(Model.SubmitError == true ? "clinic-container-error" : "clinic-container")">

              @*   @if (Model.SubmitError == true)
                {
                    <h2 class="text-center text-light align-self-center">Por favor, ingrese sus datos de manera correcta</h2>
                }
                else
                {
                    <h2 class="text-center text-light align-self-center">Por favor, seleccione un País</h2>
                } *@

            </div>

            <div id="arrowContainer" class="container d-none">
                <div class="row justify-content-around">

                    <div id="arrowLeft" class="col">
                       @*  <i class="bi bi-arrow-left-short pointer-arrow"></i> *@
                    </div>
                    <div id="arrowRight" class="col text-end">
@*                         <i class="bi bi-arrow-right-short pointer-arrow"></i>
 *@                    </div>
                </div>
            </div>


            <div id="submitter" class="d-flex align-items-center justify-content-center d-none">
                <button id="clinicButton" type="submit" class="btn col-5 col-md-4 p-2 my-5 border-light merck-button" @* data-bs-toggle="modal" data-bs-target="#exampleModal" *@>
                    Enviar Consulta
                </button>
            </div>
        </div>


        <small class="text-start">
            <em class="text-start">
                <p class="text-start"></p>
                Aquellos Centros que no se encuentren incluidos en el localizador pueden enviar una solicitud a Merck para solicitar su incorporación en el marco de este Projecto.
            </em>
        </small>

        <div class="row mt-4">
            <div class="col-12 d-flex justify-content-center">
                <a id="showAlertButton" style="text-decoration:none"><strong class="text-black">Disclaimer Formulario de Contacto y Datos Personales</strong></a>
            </div>
        </div>

    }

    <footer class="mt-3" style="background-color:white">

        <div class="footer-detail" bis_skin_checked="1">
            <div class="row g-0" bis_skin_checked="1">
                <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                    <div class="footer-legal" bis_skin_checked="1">
                        <ul class="unstyled small flush-bottom">
                            <li class="footer-legal-item">
                                <a asp-action="Privacy" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Declaración de Privacidad</strong></a>
                            </li>
                            <li class="footer-legal-item">
                                <a asp-action="TyC" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Términos y Condiciones</strong></a>
                            </li>

                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </footer>

    <div class="d-flex justify-content-center" style="border-radius:5px">
        <span class="px-4 py-2 my-3 rich-purple-bg merck-font vibrant-pink border-1" style="border-radius:10px">Merck</span>
    </div>
      
</div>





