@model ExportViewModel
@using ProyectoMerck.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<header class="header-bg-color">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
        <div class="container-fluid">
            <a href="@Url.Action("Index", "Home")" class="btn"><i class="bi bi-chevron-left header-icon-left"></i></a>
            <button class="navbar-toggler header-burger" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-light"></i>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a style="color:white" class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="row subheader-body">
    <div class="col-md-12">
        <div class="col-12 text-center vh-50 mt-35">
            <div class="row">
                <div class="d-flex justify-content-center">
                    <img src="/Imagenes/MERCK_LOGO_White_RGB.png" style="height:33px" />
                </div>
            </div>
            <div class="text-center subheader-div">
                <div class="row align-items-center">
                    <div class="col">
                        <a href="@Url.Action("Indicator","Indicator")">
                            <img src="~/imagenes/FlechaIzquierda.png" />
                        </a>
                    </div>
                    <div class="col">
                        <p class="display-4 mb-0">
                            Consulta
                        </p>
                    </div>
                    <div class="col"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row rounded-header">
    </div>
</div>

<div class="d-flex justify-content-center align-items-center">
    <div class="d-flex">
        <div class="mr-10-ml-10 container">
            <form id="exportForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label asp-for="FechaInicio">@Localizer["StartDate"].Value</label>
                <input asp-for="FechaInicio" type="date" id="FechaInicio" name="FechaInicio" class="form-control" max="2024-12-31">
@*                 <span asp-validation-for="FechaInicio"></span>
 *@
                <label asp-for="FechaFin">@Localizer["EndDate"].Value</label>
                <input asp-for="FechaFin" type="date" id="FechaFin" name="FechaFin" class="form-control" max="2024-12-31">
@*                 <span asp-validation-for="FechaFin"></span>
 *@
                <div class="row g-0 p-3">
                    <button type="button" onclick="exportar('excel')" class="btn col-12 col-md-6 p-2 my-5 border-light merck-button">
                        @Localizer["ExportExcel"].Value
                    </button>
                    <button type="button" onclick="exportar('pdf')" class="btn col-12 col-md-6 p-2 my-5 border-light merck-button">
                        @Localizer["ExportPdf"].Value
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<footer>

    <div class="footer-detail" bis_skin_checked="1">
        <div class="row g-0" bis_skin_checked="1">
            <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                <div class="footer-copyright" bis_skin_checked="1">
                    <p class="small">© 2024 Merck KGaA, Darmstadt, Alemania y/o sus filiales. Todos los derechos reservados.</p>
                </div>
            </div>
            <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                <div class="footer-legal" bis_skin_checked="1">
                    <ul class="unstyled small flush-bottom">
                        <li class="footer-legal-item">
                            <a asp-action="Privacy" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Declaración de Privacidad</strong></a>
                        </li>
                        <li class="footer-legal-item">
                            <a asp-action="TyC" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Términos y Condiciones</strong></a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>

<script>
    function exportar(tipo) {

        Swal.fire({
            icon: "info",
            title: "Ha iniciado la descarga del archivo...",
            showConfirmButton: false,
            timer: 1000
        });

        var form = document.getElementById('exportForm');
        var action = tipo === 'excel' ? "@Url.Action("ExportPeopleToExcel")" : "@Url.Action("PrintPdf")";
        form.action = action;
        form.submit();
    }

</script>