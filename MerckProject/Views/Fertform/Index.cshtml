@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model ProyectoMerck.Models.ViewModels.FertformVM

@using (Html.BeginForm("FertilityCalculator", "Fertform", HttpMethod.Post))
{
    <header class="header-bg-color">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
            <div class="container-fluid">
                <a href="@Url.Action("Index", "Home")" class="btn"><i class="bi bi-chevron-left header-icon-left"></i></a>
                <button class="navbar-toggler header-burger" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list text-light"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a style="color:white" class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="row subheader-body">
        <div class="col-md-12">
            <div class="col-12 text-center vh-50 mt-35">
                <div class="row">
                    <div class="d-flex justify-content-center">
                        <img src="/Imagenes/MERCK_LOGO_White_RGB.png" style="height:33px" />
                    </div>
                </div>
                <div class="text-center subheader-div">
                    <div class="row align-items-center">
                        <div class="col">
                            <a href="@Url.Action("Index","Login")">
                                <img src="~/imagenes/FlechaIzquierda.png" />
                            </a>
                        </div>
                        <div class="col">
                            <p class="display-4 mb-0">@* @Localizer["FertilityCalculator"].Value *@Indicador</p>
                        </div>
                        <div class="col"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row rounded-header">
        </div>
    </div>
    <div class="container">
        <div class="row border-bottom pb-5 pt-3">
            <div class="col-6 col-md-5 col-lg-4 d-flex justify-content-end">
                <img src="/Imagenes/IconoEdadActual.png">
            </div>
            <div class="col-5">
                <div class="row mt-2">
                    <h3 class="ps-0" style="color:#4A1896">@* @Localizer["FirstAge"].Value *@Edad</h3>
                </div>
                <div class="row">
                    <div class="col px-0" >
                        <label for="currentAgeYears">Fecha Nacimiento:</label>
                        <input type="month" class="form-control" id="SelectedDate" name="SelectedDate" placeholder="Seleccione">
                    </div>

                </div>
            </div>
        </div>

        <div class="row border-bottom pb-5 pt-3">
            <div class="col-6 col-md-5 col-lg-4 d-flex justify-content-end">
                <img src="/Imagenes/IconoEdadActual.png">
            </div>
            <div class="col-5">
                <div class="row pb-3">
                    <h3 class="ps-0" style="color:#4A1896">Edad planificada@* @Localizer["At what age would you like to be a mother in the future?"].Value *@</h3>
                </div>
                <div class="row">
                    @{
                        var ageOptions = new List<SelectListItem>
                            {
                            new SelectListItem { Text = "0-3 años", Value = "3" },
                            new SelectListItem { Text = "4-6 años", Value = "6" },
                            new SelectListItem { Text = "7-10 años", Value = "10" },
                            new SelectListItem { Text = ">10 años", Value = "11" },
                            new SelectListItem { Text = "No lo sé aún", Value = "0" }
                            };

                        @Html.DropDownListFor(model => model.QuestionUser, ageOptions, new { @class = "form-control" })
                    }
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-12 d-flex justify-content-center h5" style="color: #e61e50">
                @* @Html.ValidationSummary(false) *@
            </div>
            <div class="col-12 d-flex justify-content-center">
                <button type="submit" class="btn col-8 col-sm-5 offset-sm-2 offset-md-0 col-md-4 p-2 my-3 border-light merck-button">
                    <span class="spinner-container"></span>
                    <span class="m-button-span">@* @Localizer["Send"] *@Enviar</span>
                </button>
            </div>
        </div>

        <footer>

            <div class="footer-detail" bis_skin_checked="1">
                <div class="row" bis_skin_checked="1">
                    <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                        <div class="footer-copyright" bis_skin_checked="1">
                            <p class="small">© 2024 Merck KGaA, Darmstadt, Alemania y/o sus filiales. Todos los derechos reservados.</p>
                        </div>
                    </div>
                    <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                        <div class="footer-legal" bis_skin_checked="1">
                            <ul class="unstyled small flush-bottom">
                                <li class="footer-legal-item">
                                    <a asp-action="Privacy" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Declaración de Privacidad</strong></a>
                                </li>
                                <li class="footer-legal-item">
                                    <a asp-action="TyC" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Términos y Condiciones</strong></a>
                                </li>

                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

    </div>



}

