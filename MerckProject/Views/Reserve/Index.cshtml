@model ProyectoMerck.Models.ViewModels.ReserveVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Reserve";
}

<header style="background-color:#EA3B95;">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-3 ">
        <div class="container-fluid">
            <a href="@Url.Action("Index", "Home")" class="btn"><i style="color: white; font-size: 1.5em" class="bi bi-chevron-left"></i></a>
            <button style="color: white; font-size: 2em" class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list" style="color:white"></i>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a style="color:white" class="nav-link" asp-area="" asp-controller="Login" asp-action="Index">Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="row pb-3">
            <div class="d-flex justify-content-center">
                <img src="/Imagenes/MERCK_LOGO_White_RGB.png" style="height:33px" />
            </div>
        </div>
        <div class="row">
            <div class="col offset-3">
                <h3 class="text-light">EDAD ACTUAL</h3>
            </div>
        </div>
        <div class="row">
            <div class="col offset-3">
                <h3 style="font-weight:300; opacity:0.7" class="text-light">@Model.SelectedYear.ToString() AÑOS</h3>
            </div>
        </div>
        <div class="row d-flex justify-content-center">
            <a id="reserveButton" class="btn col-5 col-md-4 p-2 my-5 merck-button" href="@Url.Action("RedirectIndicator", "Reserve", new {SelectedYear = @Model.SelectedYear})">
                <span class="m-button-span">Quiero saber más!</span>
                <span class="spinner-container"></span>    
            </a>
        </div>
    </div>
    <div style="height:50px; background-color: white; border-top-left-radius:30px; border-top-right-radius:30px">
    </div>
</header>
<h3 id="tasaFertilidad" class="text-center merck-font" style="color:#EA3B95;">
    Tasa de Fertilidad
</h3>
<p class="text-center" style="color:#2EBDCD; font-weight:400; font-size: 12px">Cantidad de Ovocitos Actual (@Model.SelectedYear AÑOS) - <span style="font-weight:800">@Model.OvoCount.ToString()</span></p>
<p class="text-center" style="color:#2EBDCD; font-weight:400; font-size: 12px">Cantidad de Ovocitos a los @Model.EndAge AÑOS - <span style="font-weight:800">@Model.EndOvocites.ToString()</span></p>

<div class="container">
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <canvas id="myChart" height="200"></canvas>
        </div>
    </div>
<small>
    <em>
            *Estimación teórica de ovocitos de buena calidad
    </em>
</small>
    <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
            <a id="showAlertButton" text-decoration:none"><strong class="text-black">Disclaimer resultados</strong></a>
        </div>
    </div>

    <footer>

        <div class="footer-detail" bis_skin_checked="1">
            <div class="row" bis_skin_checked="1">
                <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                    <div class="footer-copyright" bis_skin_checked="1">
                        <p class="small">© 2024 Merck KGaA, Darmstadt, Alemania y/o sus filiales. Todos los derechos reservados.</p>
                    </div>
                </div>
                <div class="sm-col-6 md-col-12 lg-col-16 xl-col-16" bis_skin_checked="1">
                    <div class="footer-legal" bis_skin_checked="1">
                        <ul class="unstyled small flush-bottom">
                            <li class="footer-legal-item">
                                <a asp-action="Privacy" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Declaración de Privacidad</strong></a>
                            </li>
                            <li class="footer-legal-item">
                                <a asp-action="TyC" asp-controller="Legal" style="text-decoration:none"><strong class="text-black">Términos y Condiciones</strong></a>
                            </li>

                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>

</div>



<script src="~/js/chart.js"></script>
<script>

    var startAge = @Model.SelectedYear;
    var startMonth = @Model.SelectedMonth;
    var dataValues = JSON.parse('@Html.Raw(Model.OvoMatrix)');
    var foliName = 'Ovocitos'
    
    console.log(dataValues[1]);

    google.charts.setOnLoadCallback(function () {
        drawChart2(dataValues, foliName);
    });



    document.getElementById('tasaFertilidad').addEventListener('click', function () {

        gtag('event', 'reserve_button_clicked', {
            'event_category': 'Button Click',
            'event_label': 'Reserve Button Clicked'
        });

    })

    document.getElementById('tasaFertilidad').addEventListener('click', function () {
    
        gtag('event', 'fertility_text_clicked', {
            'event_category': 'Text Click',
            'event_label': 'Fertility Text Clicked!'
        });
    })

</script>

<script>
    document.getElementById('showAlertButton').addEventListener('click', function () {
        Swal.fire({
            title: 'Información',
            html: ` <div>
                        <i class="bi bi bi-book" style="font-size: 50px; color: #6c757d; margin-right: 10px; padding-bottom:15px"></i>
                        <br>
                            <div class="text-start">
                                <p>Los resultados obtenidos se basan en <a href="#citaEstudio">[cita estudio]</a>.</p>
                                <p>El método utilizado es meramente estimativo, y no representa una medición precisa de tu reserva ovárica.</p>
                                <p>La presente herramienta no constituye consejo médico de ningún tipo ni reemplaza la opinión de un médico.</p>
                                <p>Merck no recolecta ninguno de los datos personales que ingreses dentro de este sitio web, sin perjuicio de la eventual recolección de data de navegación o cookies conforme a nuestra <a href="/Legal/Privacy">Política de Privacidad</a>.</p>
                            </div>
                    </div>
                                `,
            confirmButtonText: 'Volver'
        });
    });
</script>