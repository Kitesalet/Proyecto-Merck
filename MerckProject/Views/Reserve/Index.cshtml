<script src="~/js/chart.js"></script>
<script>

    window.addEventListener('popstate', function (event) {
        // Reload the page to ensure scripts are executed again
        window.location.reload();
    });

    document.addEventListener('DOMContentLoaded', function () {
        // Your JavaScript code here
        var spinners = document.querySelectorAll('.spinner-container');
        spinners.forEach(function (spinner) {
            spinner.classList.add('d-none');
        });

        var buttonSpan = document.querySelectorAll('.m-button-span');
        buttonSpan.forEach(function (button) {
            button.classList.remove('d-none');
        });

        var buttons = document.querySelectorAll('.merck-button');
        buttons.forEach(function (button) {
            button.addEventListener('click', function () {
                let spinnerContainer = this.querySelector('.spinner-container');
                spinnerContainer.classList.remove('d-none');
                let buttonSpan = this.querySelector('.m-button-span');
                buttonSpan.classList.add('d-none');
                spinnerContainer.classList.add('spinner-grow', 'text-light');
            });
        });
    });

    var startAge = @Model.SelectedYear;
    var startMonth = @Model.SelectedMonth;
    var dataValues = JSON.parse('@Html.Raw(Model.OvoMatrix)');
    var foliName = 'Ovocitos'
    
    console.log(dataValues[1]);

    google.charts.setOnLoadCallback(function () {
        drawChart2(dataValues, foliName);
    });



    document.getElementById('tasaFertilidad').addEventListener('click', function () {

        gtag('event', 'reserve_button_clicked', {
            'event_category': 'Button Click',
            'event_label': 'Reserve Button Clicked'
        });

    })

    document.getElementById('tasaFertilidad').addEventListener('click', function () {
    
        gtag('event', 'fertility_text_clicked', {
            'event_category': 'Text Click',
            'event_label': 'Fertility Text Clicked!'
        });
    })

</script>

