@model ProyectoMerck.Models.ViewModels.ReserveVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<header style="background-color:#EA3B95;">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-3 ">
        <div class="container-fluid">
            <a href="@Url.Action("Index", "Home")" class="btn"><i style="color: white; font-size: 1.5em" class="bi bi-chevron-left"></i></a>
            <button style="color: white; font-size: 2em" class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list" style="color:white"></i>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a style="color:white" class="nav-link" asp-area="" asp-controller="Login" asp-action="Index">Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="row pb-3">
            <div class="d-flex justify-content-center">
                <img src="/Imagenes/MERCK_LOGO_White_RGB.png" style="height:33px" />
            </div>
        </div>
        <div class="row">
            <div class="col offset-3">
                <h3 class="text-light">@Localizer["ActualAge"].Value</h3>
            </div>
        </div>
        <div class="row">
            <div class="col offset-3">
                <h3 style="font-weight:300; opacity:0.7" class="text-light">@String.Format(Localizer["ActualAgeNumber"].Value, Model.SelectedYear.ToString())</h3>
            </div>
        </div>
        <div class="row d-flex justify-content-center">
            <a class="btn col-5 col-md-4 p-2 my-5 border-light merck-button" href="@Url.Action("RedirectIndicator", "Reserve", new {SelectedYear = @Model.SelectedYear})">
                <span class="m-button-span">@Localizer["KnowMore"].Value</span>
                <span class="spinner-container"></span>    
            </a>
        </div>
    </div>
    <div style="height:50px; background-color: white; border-top-left-radius:30px; border-top-right-radius:30px">
    </div>
</header>
    <h3 class="text-center merck-font" style="color:#EA3B95;">@Localizer["FertilityRate"].Value</h3>
<p class="text-center" style="color:#2EBDCD; font-weight:400; font-size: 12px">Cantidad de Ovocitos Actual (@Model.SelectedYear AÑOS) - <span style="font-weight:800">@Model.OvoCount.ToString()</span></p>
<p class="text-center" style="color:#2EBDCD; font-weight:400; font-size: 12px">Cantidad de Ovocitos a los @Model.EndAge AÑOS - <span style="font-weight:800">@Model.EndOvocites.ToString()</span></p>

<div class="container">
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <canvas id="myChart" height="200"></canvas>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
            <a id="showAlertButton" style="color:blue; text-decoration:underline">Disclaimer resultados</a>
        </div>
    </div>
</div>




<script src="~/js/chart.js"></script>
<script>

    var startAge = @Model.SelectedYear;
    var startMonth = @Model.SelectedMonth;
    var dataValues = JSON.parse('@Html.Raw(Model.OvoMatrix)');
    var foliName = '@Localizer["FoliName"].Value'
    
    console.log(dataValues[1]);

    google.charts.setOnLoadCallback(function () {
        drawChart2(dataValues, foliName);
    });

</script>

<script>
    document.getElementById('showAlertButton').addEventListener('click', function () {
        Swal.fire({
            title: 'Información',
            html: `
                    <p>Los resultados obtenidos se basan en <a href="#citaEstudio">[cita estudio]</a>.</p>
                    <p>El método utilizado es meramente estimativo, y no representa una medición precisa de tu reserva ovárica.</p>
                    <p>La presente herramienta no constituye consejo médico de ningún tipo ni reemplaza la opinión de un médico.</p>
                    <p>Merck no recolecta ninguno de los datos personales que ingreses dentro de este sitio web, sin perjuicio de la eventual recolección de data de navegación o cookies conforme a nuestra <a href="/Legal/Privacy">Política de Privacidad</a>.</p>
                `,
            icon: 'info',
            confirmButtonText: 'Comprendido!'
        });
    });
</script>